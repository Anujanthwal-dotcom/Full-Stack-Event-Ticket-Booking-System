# Server
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:7001/ticketly-db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
SESSION_SECRET=change-me-to-a-secure-random-string

# AWS S3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_S3_BUCKET=ticketly-tickets
AWS_S3_ENDPOINT=http://localhost:4566

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OAuth2 - Google
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# OAuth2 - Facebook
FACEBOOK_CLIENT_ID=...
FACEBOOK_CLIENT_SECRET=...

# Gemini AI
GEMINI_API_KEY=...

# Mail (SMTP)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=...
MAIL_PASSWORD=...
MAIL_FROM=...

# App
CORS_ORIGIN=http://localhost:3000
OAUTH_SUCCESS_REDIRECT=http://localhost:3000
OAUTH_FAILURE_REDIRECT=http://localhost:3000/notAuthorized
